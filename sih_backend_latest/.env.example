# Add these entries to your existing .env; do not replace existing settings.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free
# Opt in locally; leave false outside development.
AI_TEST_ENDPOINT_ENABLED=false

# Final application configuration (keep credentials in your own .env)
DATABASE_URL = "postgresql://postgres:517204@localhost:5432/sih_db"
# Set a random secret of at least 32 bytes. Empty is local ephemeral mode only.
JWT_SECRET=
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local voice transcription (faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional model cache on a writable volume, or bake a model directory into the image
# and set WHISPER_MODEL to its absolute path.
WHISPER_DOWNLOAD_ROOT=
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_CPU_THREADS=2
# Production: set CORS_ORIGINS to the exact HTTPS frontend origin (no path).
